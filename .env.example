PORT=4000
# Local: http://localhost:4300 | Vercel: https://faraon-client.vercel.app
CLIENT_URL=http://localhost:4300

# Stripe test mode. Nunca expongas esta clave en Angular.
STRIPE_SECRET_KEY=sk_test_replace_me

# Resend. Usa un dominio verificado al pasar a producción.
RESEND_API_KEY=re_replace_me
RESEND_FROM=onboarding@resend.dev

# Supabase/Postgres. La API aplica migrations/001_initial.sql al arrancar.
POSTGRES_URL_NON_POOLING=postgres://postgres.project:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_URL=postgres://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_PRISMA_URL=
POSTGRES_HOST=db.project.supabase.co
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me

# Opcionales para integraciones futuras con Supabase JS; nunca van al cliente.
SUPABASE_URL=https://project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Cuenta administradora y sesiones de la API.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
JWT_SECRET=replace_with_a_long_random_secret
